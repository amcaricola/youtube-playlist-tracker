# YouTube Playlist Tracker — Variables de Entorno

# Puerto del servidor backend (Hono)
PORT=3000

# Master password del Super Usuario (se hashea en data/config.json en el primer arranque)
MASTER_PASSWORD=change-me-super-secure

# Clave API de YouTube (lectura pública de playlists y videos)
YOUTUBE_API_KEY=

# OAuth 2.0 — YouTube Data API v3 (scopes de modificación)
# 1) Crea credenciales OAuth Client en Google Cloud Console (tipo "Web application" o "Desktop")
# 2) Autoriza la API "YouTube Data API v3"
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback

# URL base del frontend (para la redirección al terminar el flujo OAuth)
CLIENT_URL=http://localhost:5173

# Token de sesión: duración en días
SESSION_TTL_DAYS=30

# Intervalo mínimo entre verificaciones de un mismo video (horas)
CHECK_INTERVAL_HOURS=24

# Tamaño máximo de lote por llamada a videos.list (YouTube permite hasta 50)
BATCH_SIZE=50